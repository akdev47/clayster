# Copy to .env and fill in. docker compose reads .env automatically.

# Required. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated host names the site is served on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins (with scheme) for form posts, e.g. https://clayster.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to true when a reverse proxy terminates HTTPS in front of the container.
DJANGO_BEHIND_HTTPS_PROXY=false

# Port on this machine that the site is published on.
WEB_PORT=8000
